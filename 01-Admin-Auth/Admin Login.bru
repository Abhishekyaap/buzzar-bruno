meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth-admin/login
  body: json
  auth: none
}

body:json {
{
  "email": "admin@buzzar.co",
  "password": "Password123"
}
}

script:post-response {
if (res.body && res.body.data && res.body.data.access_token) {
  bru.setEnvVar("adminToken", res.body.data.access_token);
}
}
