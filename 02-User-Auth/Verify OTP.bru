meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/verify-otp
  body: json
  auth: none
}

body:json {
{
  "phone": "9876543210",
  "code": "123456"
}
}

script:post-response {
if (res.body && res.body.data && res.body.data.token) {
  bru.setEnvVar("userToken", res.body.data.token);
}
}
